{
  "name": "jstack",
  "private": true,
  "version": "2.1.3",
  "description": "If you want to go fast, go deep first. JStack helps you write less, but higher quality code: rigorous agent workflows you can parallelize with confidence. Pi package of the Claude Code plugin; skills are shared, tool names resolve via skills/jedi-mode/references/pi-tools.md. Built on Lauren Tan's pstack and Michael Denyer's pstack-claude port.",
  "author": {
    "name": "Jake Gorgol",
    "url": "https://github.com/jgorgs"
  },
  "homepage": "https://github.com/jgorgs/jstack",
  "repository": "https://github.com/jgorgs/jstack",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "jstack",
    "jedi-mode",
    "workflow",
    "principles",
    "agent-style",
    "subagents",
    "unslop",
    "claude-code",
    "skills",
    "tdd",
    "code-review",
    "parallel-agents",
    "codex",
    "opencode",
    "gemini-cli",
    "prime-agent"
  ],
  "pi": {
    "skills": [
      "./plugins/jstack/skills"
    ],
    "extensions": [
      "./plugins/jstack/pi/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  }
}
